{
  "log": {
    "version": "1.2",
    "creator": {
      "name": "synthetic sample",
      "version": "1"
    },
    "entries": [
      {
        "request": {
          "method": "GET",
          "url": "https://docs.example.com/",
          "headers": []
        },
        "response": {
          "status": 200,
          "headers": [
            {
              "name": "Content-Security-Policy",
              "value": "default-src 'self'; frame-ancestors 'self'"
            },
            {
              "name": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "name": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "name": "Strict-Transport-Security",
              "value": "max-age=31536000; includeSubDomains"
            },
            {
              "name": "Set-Cookie",
              "value": "pref=1; Path=/; Secure; HttpOnly; SameSite=Lax"
            }
          ],
          "content": {
            "mimeType": "text/html"
          }
        }
      },
      {
        "request": {
          "method": "GET",
          "url": "https://docs.example.com/style.css",
          "headers": []
        },
        "response": {
          "status": 200,
          "headers": [],
          "content": {
            "mimeType": "text/css"
          }
        }
      }
    ]
  }
}
