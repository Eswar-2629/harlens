{
  "log": {
    "version": "1.2",
    "creator": {
      "name": "synthetic sample",
      "version": "1"
    },
    "entries": [
      {
        "request": {
          "method": "GET",
          "url": "https://shop.example.com/",
          "headers": []
        },
        "response": {
          "status": 200,
          "headers": [
            {
              "name": "Server",
              "value": "nginx/1.18.0"
            },
            {
              "name": "X-Powered-By",
              "value": "Express"
            },
            {
              "name": "Set-Cookie",
              "value": "sessionid=demo-fake-session-value-000; Path=/"
            },
            {
              "name": "Set-Cookie",
              "value": "theme=dark; Path=/; Secure; SameSite=None"
            }
          ],
          "content": {
            "mimeType": "text/html"
          }
        }
      },
      {
        "request": {
          "method": "GET",
          "url": "http://cdn.example.com/app.js",
          "headers": []
        },
        "response": {
          "status": 200,
          "headers": [],
          "content": {
            "mimeType": "application/javascript"
          }
        }
      },
      {
        "request": {
          "method": "GET",
          "url": "http://cdn.example.com/logo.png",
          "headers": []
        },
        "response": {
          "status": 200,
          "headers": [],
          "content": {
            "mimeType": "image/png"
          }
        }
      },
      {
        "request": {
          "method": "GET",
          "url": "https://shop.example.com/api/export?api_key=demo_not_a_real_key_12345&format=csv",
          "headers": []
        },
        "response": {
          "status": 200,
          "headers": [],
          "content": {
            "mimeType": "application/json"
          }
        }
      },
      {
        "request": {
          "method": "GET",
          "url": "https://api.example.com/data",
          "headers": []
        },
        "response": {
          "status": 200,
          "headers": [
            {
              "name": "Access-Control-Allow-Origin",
              "value": "*"
            },
            {
              "name": "Access-Control-Allow-Credentials",
              "value": "true"
            }
          ],
          "content": {
            "mimeType": "application/json"
          }
        }
      },
      {
        "request": {
          "method": "POST",
          "url": "http://login.example.com/session",
          "headers": [
            {
              "name": "Cookie",
              "value": "sid=demo-fake-cookie"
            }
          ],
          "postData": {
            "mimeType": "application/x-www-form-urlencoded",
            "text": "user=demo&password=demo-not-real"
          }
        },
        "response": {
          "status": 200,
          "headers": [],
          "content": {
            "mimeType": "application/json"
          }
        }
      }
    ]
  }
